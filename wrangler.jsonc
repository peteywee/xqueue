{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xqueue-preview",
  "main": "cloudflare/src/worker.mjs",
  "compatibility_date": "2026-09-02",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xqueue-preview",
      "database_id": "f5f9bea9-e88c-41ab-9407-70356079a638",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "xqueue-media"
    }
  ]
}
