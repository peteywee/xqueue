# developer.x.com -> your app -> Keys and tokens
#
# App permissions must be set to Read and Write BEFORE you generate the
# access token. If you generate it first it inherits read-only and every
# post will 403.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional overrides
# LIBRARY_DIR=./content
# MEDIA_DIR=./media
