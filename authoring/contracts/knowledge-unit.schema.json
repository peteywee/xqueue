{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xqueue.local/schemas/knowledge-unit.schema.json",
  "title": "XQueue Author Knowledge Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["knowledge_unit_id", "kind", "summary", "claim_class", "support_state", "source_refs", "possible_outputs"],
  "properties": {
    "knowledge_unit_id": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": ["lesson", "principle", "failure", "decision", "example", "question", "claim", "framework", "observation"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "claim_class": {
      "enum": ["conceptual", "experiential", "current_factual", "generated_assertion"]
    },
    "support_state": {
      "enum": ["supported", "owner_attestation_required", "research_required", "hypothesis", "internal_only"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "possible_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["post", "blog", "lesson"] }
    },
    "sensitivity": { "enum": ["public", "internal", "sensitive", "restricted"] },
    "failure_context": { "type": ["string", "null"] },
    "used_artifact_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remaining_angles": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
