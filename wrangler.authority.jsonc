{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xqueue-publisher-production",
  "main": "cloudflare/src/publisher-worker.mjs",
  "compatibility_date": "2026-09-02",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xqueue-production",
      "database_id": "fc85026e-bfc8-435f-8bb0-c60e139178a3",
      "migrations_dir": "cloudflare/migrations-production"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "xqueue-media"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "XQUEUE_PUBLISH_AUTHORITY": "enabled"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
