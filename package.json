{
  "name": "xqueue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Content queue, rule validator, and scheduled poster for the restaurant-operations X account",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "test": "node --test test/*.test.mjs",
    "validate": "node src/cli.mjs validate",
    "validate:production": "node src/cli.mjs validate --production",
    "build": "node src/cli.mjs build",
    "stats": "node src/cli.mjs stats",
    "next": "node src/cli.mjs next",
    "health": "node scripts/xqueue-health.mjs",
    "post": "node src/cli.mjs post --dry-run",
    "post:dry": "node src/cli.mjs post --dry-run",
    "post:live": "node src/cli.mjs post --live",
    "reconcile": "node src/cli.mjs reconcile",
    "verify": "pnpm test && pnpm validate && node scripts/xqueue-health.mjs --repair && node scripts/xqueue-health.mjs"
  },
  "dependencies": {
    "@xdevplatform/xdk": "^0.6.6",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@xdevplatform/xurl": "^1.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
