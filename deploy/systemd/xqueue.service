[Unit]
Description=XQueue local compatibility dry-run
Documentation=file:%h/xqueue/docs/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/xqueue
EnvironmentFile=%h/.config/xqueue/runtime.env
ExecStartPre=/bin/bash %h/xqueue/deploy/systemd/check-runtime.sh
ExecStart=/bin/bash -c 'exec "$$XQUEUE_COREPACK" pnpm post:dry'
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
