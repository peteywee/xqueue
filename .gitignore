# Credentials — never commit
.env

# Generated/runtime state
queue.json
# Media manifest binds required figures to real local bytes; regenerate it locally.
media-manifest.json
state.json
post.log
.xqueue-publish.lock

# Local authoring workspace — generated drafts, reviews, approvals, promotion plans
.xqueue-author/

# Figures are binary and large; keep them local
media/*
!media/.gitkeep

.wrangler/
node_modules/

# npm is not used here — the preinstall guard rejects it,
# but a stray lockfile must never come back.
package-lock.json
yarn.lock
*.swp
.post.lock
*.bak
*.pre-*
*.before-*
*~
env.ts
oauth2.ts
